# Copy this file to .env and fill in your API key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# question_rerank is the minimal measured fix. Other opt-in profiles:
# intent_baseline, original_query, coverage_retry (adds LLM coverage checks).
RAG_RETRIEVAL_PROFILE=question_rerank
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
# Includes reasoning tokens as well as the visible answer.
OPENAI_MAX_OUTPUT_TOKENS=4096
