# Copy this file to .env and fill in your API key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# candidate_recovery_v2 is the best measured strategy (default). Other profiles
# remain reproducible ablations: intent_baseline, question_rerank, original_query,
# coverage_retry, coverage_diagnostic, candidate_recovery, coverage_answer_plan.
RAG_RETRIEVAL_PROFILE=candidate_recovery_v2
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
# Includes reasoning tokens as well as the visible answer.
OPENAI_MAX_OUTPUT_TOKENS=4096
# Tool-calling agent mode (papers fetched from arXiv during a conversation).
CONVERSATION_TTL_DAYS=30
MAX_PAPERS_PER_CONVERSATION=12
MAX_NEW_PAPERS_PER_TURN=2
ARXIV_MAX_PDF_MB=40
ARXIV_MAX_PAGES=60

# Sharing with testers (see docs/partage-testeurs.md). Leave ACCESS_MODE=open for local use.
ACCESS_MODE=open
# Behind a Cloudflare tunnel: believe CF-Connecting-IP for per-client rate limits.
TRUST_PROXY_HEADERS=
# Questions processed at the same time (default 2 in invite mode).
MAX_CONCURRENT_QUESTIONS=
# Cap on papers downloaded per day across all testers (0 = unlimited).
MAX_NEW_PAPERS_PER_DAY=0
# Public https URL used by `python -m app.invites create` to print the invitation link,
# for example https://evidentia.abdennour.tech
PUBLIC_BASE_URL=
# Token of the Cloudflare tunnel (docker compose --profile tunnel up -d). Never commit it.
TUNNEL_TOKEN=
